# ─────────────────────────────────────────────────────────────────────────────
# Brightrail configuration. Copy to .env and fill in. See SETUP.md for where each
# value comes from. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the app (no trailing slash). Used in emails and webhook URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (database + authentication) — https://supabase.com, free tier ──
# Project Settings → API (or Data API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row-level security — keep secret, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Credential encryption ──
# 32 random bytes, base64. Generate with:  openssl rand -base64 32
# (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# Changing it later makes stored connection secrets unreadable.
BRIGHTRAIL_ENCRYPTION_KEY=

# ── Inngest (durable workflow execution) — https://www.inngest.com, free tier ──
# Local development: set INNGEST_DEV=1 and run `npx inngest-cli@latest dev`.
# Production: leave INNGEST_DEV empty and set both keys from Inngest Cloud.
INNGEST_DEV=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── AI exception assistant (optional) — Google AI Studio, free tier ──
# Leave empty to use the built-in rule-based analysis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Notification emails (optional) — uses Resend, free tier ──
# Brightrail's own sender for "run failed" / "approval needed" emails (separate from the
# Resend connections people add for their workflows). Leave empty to keep notifications in-app only.
# EMAIL_FROM must use a domain verified in Resend, e.g. Brightrail <alerts@yourdomain.com>.
# For a quick test, "Brightrail <onboarding@resend.dev>" works but only delivers to your own Resend account email.
RESEND_API_KEY=
EMAIL_FROM=

# ── End-to-end tests (optional) — a confirmed test user that already has a workspace ──
E2E_EMAIL=
E2E_PASSWORD=
